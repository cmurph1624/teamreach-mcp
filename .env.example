# TeamReach session credentials. There is no public API or OAuth flow; these
# come from the TeamReach mobile app's own requests (captured with an HTTPS
# debugging proxy) and expire periodically.
TEAMREACH_UID=
TEAMREACH_TOKEN=
TEAMREACH_TIMEZONE=America/Denver

# Group allowlist (comma-separated group IDs). Tools refuse any group not listed here.
TEAMREACH_READABLE_GROUPS=123456,654321
# Groups scanned by teamreach_check_rsvps
TEAMREACH_MONITORED_GROUPS=123456,654321
# Default group for teamreach_book_weekly when no group_id is passed
TEAMREACH_BOOKING_GROUP=654321
# Optional friendly names accepted wherever a group_id is expected
TEAMREACH_GROUP_ALIASES=morning=123456,test=654321

# Supabase (RSVP snapshots and the pending-drop ledger)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Bearer token for the optional Vercel HTTP transport (not used by stdio)
MCP_SECRET=
